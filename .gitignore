```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
yarn.lock
package-lock.json

# Build outputs
dist/
build/
.next/
.nuxt/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/
istanbul/
```